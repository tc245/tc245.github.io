---
import Icon from './Icon.astro';
import EvidenceCard from './EvidenceCard.astro';
import { publicRecords, safeJson } from '../lib/evidence';
import { THEMES, TYPES, PLACES, POPULATIONS, filterRecords, defaultFilters, mapCount } from '../lib/catalogue';
interface Props { mode: 'library' | 'map'; }
const { mode } = Astro.props;
const sorted = filterRecords(publicRecords, defaultFilters());
const filters = [{name:'theme',title:'Learning theme',options:THEMES,all:'All themes'}, {name:'type',title:'Knowledge type',options:TYPES,all:'All types'}, {name:'population',title:'Population',options:POPULATIONS,all:'All populations'}, {name:'place',title:'Place',options:PLACES,all:'All places'}];
---
<section class="page-intro"><div class="container"><p class="eyebrow">{mode === 'map' ? 'Fictional collection coverage' : 'Fictional community health records'}</p><h1>{mode === 'map' ? 'The evidence map' : 'The evidence library'}<span class="title-dot">.</span></h1><p>{mode === 'map' ? 'The map groups example records by learning theme and knowledge type. Empty cells show gaps in this demonstration collection.' : 'Search the example records or filter by theme, knowledge type, population and place. Each record includes findings, methods and limitations.'}</p></div></section>
<section class="container explorer" data-explorer data-mode={mode}>
  <aside class="filter-panel"><form id="filter-form" autocomplete="off"><fieldset disabled data-js-controls><legend class="sr-only">Filter evidence records</legend><details open><summary>Refine your view <span aria-hidden="true">⌄</span></summary><div class="filter-fields"><label for="search">Search the evidence</label><div class="search-field"><Icon name="search" size={18}/><input id="search" name="q" type="search" placeholder="Try ‘walking’ or ‘housing’" /></div>{filters.map(filter => <div class="filter-group"><label for={filter.name}>{filter.title}</label><select name={filter.name} id={filter.name}><option value="">{filter.all}</option>{filter.options.map(option=><option value={option.id}>{option.title}</option>)}</select></div>)}<button class="reset-link" type="button" data-reset>Reset all filters <span aria-hidden="true">↺</span></button></div></details></fieldset></form><div class="filter-note"><Icon name="info" size={19}/><p><strong>No ranking of knowledge types.</strong> Knowledge types sit side by side. An assessment describes a record, not the value of a community’s experience.</p></div></aside>
  <div class="explorer-content"><div class="results-toolbar"><p id="result-count" role="status" aria-live="polite" aria-atomic="true"><strong>{publicRecords.length}</strong> example records</p><div class="view-switch" aria-label="Evidence views"><a href="/evidence/" data-view="library" aria-current={mode === 'library' ? 'page' : undefined}><Icon name="book" size={17}/>Library</a><a href="/map/" data-view="map" aria-current={mode === 'map' ? 'page' : undefined}><Icon name="grid" size={17}/>Map</a></div></div>
    <noscript><p class="notice">Search, filters and sorting need JavaScript. Without it, the library and map show the unfiltered demonstration collection. Individual record pages remain readable.</p></noscript>
    <div id="active-filters" class="active-filters" role="group" aria-label="Active filters"></div>
    {mode === 'library' ? <><div class="library-subhead"><p>All content below is fictional demonstration material.</p><div><label for="sort">Sort by</label><select id="sort" name="sort" form="filter-form" disabled data-sort><option value="newest">Newest first</option><option value="oldest">Oldest first</option><option value="title">Title A–Z</option></select></div></div><div class="record-list" id="record-list">{sorted.map(record=><EvidenceCard record={record}/>)}</div></> : <><div class="map-explainer"><h2>Record counts by theme and type</h2><p>Select a number to explore its records. Counts show coverage, <strong>not effectiveness or certainty.</strong> A record can appear in more than one row; the total above counts unique records.</p></div><div class="map-scroll" role="region" aria-label="Evidence map table. Scroll horizontally on small screens." tabindex="0"><table class="evidence-map"><caption class="sr-only">Number of fictional records by learning theme and knowledge type, reflecting your current filters.</caption><thead><tr><th scope="col">Learning theme</th>{TYPES.map(type=><th scope="col"><span class={`type-dot type-${type.id}`}></span>{type.title}</th>)}</tr></thead><tbody>{THEMES.map(theme=><tr><th scope="row">{theme.title}</th>{TYPES.map(type=>{const n=mapCount(publicRecords,theme.id,type.id);return <td data-cell data-theme={theme.id} data-type={type.id} class={n ? `density-${Math.min(n,4)}` : 'density-0'}><a href={`/evidence/?theme=${theme.id}&type=${type.id}`} hidden={!n} data-cell-link aria-label={`${n} records: ${theme.title}, ${type.title}`}><strong>{n}</strong><span>{n===1?'record':'records'} <span aria-hidden="true">↗</span></span></a><span data-cell-empty hidden={!!n}><span aria-hidden="true">—</span><span class="sr-only">No matching records in this demonstration set</span></span></td>})}</tr>)}</tbody></table></div><div class="map-legend"><span><i class="legend-swatch"></i> More records</span><span><i class="legend-swatch empty"></i> No matching records in this demo set</span></div><div class="gap-note"><Icon name="info" size={24}/><div><h3>Reading an empty cell</h3><p>An empty cell means no matching records in this fictional collection. It does not mean there is no evidence elsewhere, or that an intervention has no effect.</p></div></div></>}
    <div class="empty-results" id="empty-results" hidden><Icon name="search" size={36}/><h2>No records match this combination</h2><p>Try a broader search, change a filter, or return to all the example records.</p><button type="button" class="button button-primary" data-reset>Clear filters <Icon /></button></div>
    <div class="collection-note"><span><Icon name="check" size={18}/> Public demo records in JSON</span><a href="/data/evidence.json" download>Download the demo register <Icon name="download" size={16}/></a></div>
  </div>
</section>
<script id="evidence-data" type="application/json" set:html={safeJson(publicRecords)} />
<script>import '../scripts/explorer';</script>
