---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import EvidenceCard from '../components/EvidenceCard.astro';
import '../styles/learning.css';
import { publicRecords } from '../lib/evidence';
import { THEMES, TYPES, mapCount } from '../lib/catalogue';
const themeIcons = ['leaf', 'people', 'work', 'sun'];
const featured = ['cooler-walking-routes', 'evening-street-comfort', 'family-food-session-timing'].map(id => publicRecords.find(r => r.id === id)!);
---
<Layout title="Hub concept demo">
  <section class="hero"><div class="container hero-grid">
    <div class="hero-copy"><p class="eyebrow"><span class="little-line"></span> Community Evidence Hub</p><h1>A community health<br /><em>evidence hub demo.</em></h1><p class="hero-description">Browse example records, inspect a six-study synthesis and explore a fictional food-access scenario. Follow the findings and the assumptions behind each view.</p><div class="hero-actions"><a class="button button-primary" href="/learning/food-access/">Open the worked example <Icon /></a><a class="text-link" href="/evidence/">Explore the library <Icon name="book" size={17}/></a></div><div class="hero-footnote"><span class="stacked-dots" aria-hidden="true"><i></i><i></i><i></i></span>Synthetic evidence. Reproducible calculations.</div></div>
    <div class="hero-visual">
      <div class="visual-topline"><span class="eyebrow">Coverage preview</span><span class="live-pill">Illustrative coverage</span></div>
      <div class="mini-map" role="img" aria-label="Evidence map preview. Use the Explore the full evidence map link to open the complete table on a separate page.">
        <div class="mini-map-labels" aria-hidden="true"><span></span>{TYPES.map(t => <span>{t.title.split(' ')[0]}</span>)}</div>
        {THEMES.map(theme => <div class="mini-map-row" aria-hidden="true"><span>{theme.title}</span>{TYPES.map(type => {const count=mapCount(publicRecords,theme.id,type.id);return <span class:list={['mini-cell', count ? `fill-${Math.min(count,4)}` : 'empty-cell']}>{count || '—'}</span>})}</div>)}
      </div>
      <div class="visual-caption"><span><span class="legend-dot"></span> Record counts by theme and type</span><a href="/map/" aria-label="Explore the full evidence map"><Icon /></a></div>
      <div class="floating-note"><span class="note-icon"><Icon name="info" size={19}/></span><p><strong>A gap in this collection.</strong><span>Absence of evidence isn’t evidence of no effect.</span></p></div>
    </div>
  </div></section>
  <section class="stats-strip"><div class="container stats-inner"><div><strong>{publicRecords.length}</strong><span>fictional library records</span></div><div><strong>6</strong><span>synthetic trials in the worked example</span></div><div><strong>200</strong><span>households in the scenario model</span></div><p>Study findings and model outputs<br /><strong>are shown separately.</strong></p></div></section>
  <section class="home-worked-example"><div class="container worked-example-inner"><div><p class="eyebrow">New worked question · Food access</p><h2>Study estimates and a separate access scenario</h2><p>Compare a main analysis and a sensitivity check, then explore reach, affordability and opening hours.</p></div><div class="worked-example-links"><a class="text-link" href="/learning/food-access/effects/">Inspect the analysis <Icon size={17}/></a><a class="text-link" href="/learning/food-access/scenario/">Try the scenario <Icon size={17}/></a></div></div></section>
  <section class="section container"><div class="section-heading"><div><p class="eyebrow">Four illustrative themes</p><h2>Explore a learning theme</h2></div><p>Choose a theme to filter the library.<br />Some records belong to more than one theme.</p></div><div class="theme-grid">{THEMES.map((theme,i) => <a class={`theme-card theme-${i}`} href={`/evidence/?theme=${theme.id}`}><span class="theme-icon"><Icon name={themeIcons[i]} size={26}/></span><h3>{theme.title}</h3><p>{theme.description.replace(/^Illustrative evidence about /, 'Explore ')}</p><span class="theme-card-end"><span>{publicRecords.filter(r=>r.themes.includes(theme.id)).length} example records</span><Icon /></span></a>)}</div></section>
  <section class="section featured-section"><div class="container"><div class="section-heading"><div><p class="eyebrow">From the fictional register</p><h2>Three example records</h2></div><a class="text-link" href="/evidence/">Browse all records <Icon /></a></div><div class="featured-grid">{featured.map(record=><EvidenceCard record={record}/>)}</div></div></section>
  <section class="section container"><div class="how-grid"><div><p class="eyebrow">Reading an example record</p><h2>See the finding.<br /><em>Keep the context.</em></h2><p class="section-lead">Each record includes a reviewer-supplied example assessment, its reason and a link to a fictional source sheet.</p><a class="text-link" href="/about/">Our approach to evidence <Icon /></a></div><ol class="principle-list"><li><span>01</span><div><h3>Find your question</h3><p>Filter by theme, place or population to find examples from different knowledge types.</p></div></li><li><span>02</span><div><h3>Look beyond the headline</h3><p>Read the assessment alongside its explanation, methods and limitations.</p></div></li><li><span>03</span><div><h3>Make room for what’s missing</h3><p>Use the map to identify coverage and gaps, without mistaking a count for certainty.</p></div></li></ol></div></section>
</Layout>
