# Copy to .env. These are configuration values, not credentials.
# Public HTTPS: use a DNS hostname only, e.g. demo.example.org.
# Local HTTP preview: DEMO_HOST=http://localhost, HTTP_PORT=8080,
# HTTPS_PORT=8443, BIND_ADDRESS=127.0.0.1; browse http://localhost:8080.
DEMO_HOST=localhost
HTTP_PORT=80
HTTPS_PORT=443
BIND_ADDRESS=0.0.0.0
DEMO_IMAGE=evidence-hub-demo:local
